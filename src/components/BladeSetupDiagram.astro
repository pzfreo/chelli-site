---
// End-on section through the two blades, to scale (1 mm = 60 units).
// Blade thickness and bevel angle come from gramil (0.7 mm, 25°).
interface Props {
  variant: 'supplied' | 'purfling';
}

const { variant } = Astro.props;

const s = 60;
const t = 0.7 * s;
const bevelLength = t / Math.tan((25 * Math.PI) / 180);
const top = 20;
const tip = 200;
const bevelStart = tip - bevelLength;
const purfling = 1.1 * s; // any width; illustrative only

// Each blade is drawn from its flat face. `flatOnLeft` puts the flat face
// (and so the sharp edge) on the left-hand side of the blade. The top is a
// zigzag break line: the blades carry on upwards beyond the drawing.
function blade(x: number, flatOnLeft: boolean) {
  const flat = flatOnLeft ? x : x + t;
  const back = flatOnLeft ? x + t : x;
  const step = (flat - back) / 4;
  const zigzag = [1, 2, 3].map((i) => `L${back + step * i},${top + (i % 2 ? -5 : 5)}`).join(' ');
  return `M${flat},${top} L${flat},${tip} L${back},${bevelStart} L${back},${top} ${zigzag} Z`;
}

let left: number, right: number, edges: [number, number];
if (variant === 'supplied') {
  // Bevels facing each other, sharp edges on the outside.
  left = 150 - t;
  right = 150;
  edges = [left, right + t];
} else {
  // Sharp edges facing each other, purfling clamped between.
  left = 150 - purfling / 2 - t;
  right = 150 + purfling / 2;
  edges = [left + t, right];
}
const plate = tip;
const dimY = 250;
---

<svg viewBox="0 0 300 290" class="w-full h-auto" role="img" aria-label={variant === 'supplied'
  ? 'Blades with bevels facing inward and sharp edges outward, marking lines 1.4 mm apart'
  : 'Blades with sharp edges facing inward and a strip of purfling clamped between them'}>
  <!-- Wood -->
  <rect x="10" y={plate} width="280" height="22" fill="#ecdcbc" />
  <line x1="10" y1={plate} x2="290" y2={plate} stroke="#8a6d3b" stroke-width="1.5" />
  {edges.map((x) => <line x1={x} y1={plate} x2={x} y2={plate + 12} stroke="#1a1a1a" stroke-width="2.5" />)}

  <!-- Purfling -->
  {variant === 'purfling' && (
    <g>
      <rect x={left + t} y="0" width={purfling} height={bevelStart - 4} fill="#1a1a1a" />
      <rect x={left + t + purfling * 0.3} y="0" width={purfling * 0.4} height={bevelStart - 4} fill="#f3eee2" />
    </g>
  )}

  <!-- Blades -->
  <path d={blade(left, variant === 'supplied')} fill="#b9bec6" stroke="#374151" stroke-width="1.5" stroke-linejoin="round" />
  <path d={blade(right, variant !== 'supplied')} fill="#b9bec6" stroke="#374151" stroke-width="1.5" stroke-linejoin="round" />

  <!-- Dimension -->
  {edges.map((x) => <line x1={x} y1={plate + 16} x2={x} y2={dimY + 6} stroke="#b8860b" stroke-width="1" />)}
  <line x1={edges[0]} y1={dimY} x2={edges[1]} y2={dimY} stroke="#b8860b" stroke-width="1.5" marker-start={`url(#arrow-${variant})`} marker-end={`url(#arrow-${variant})`} />
  <text x="150" y={dimY + 26} text-anchor="middle" font-size="14" fill="#b8860b">
    {variant === 'supplied' ? '1.4 mm' : 'width of your purfling'}
  </text>
  <defs>
    <marker id={`arrow-${variant}`} viewBox="0 0 10 10" refX="5" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
      <path d="M0,0 L10,5 L0,10 Z" fill="#b8860b" />
    </marker>
  </defs>

  <!-- Labels -->
  <g font-size="12" fill="#4b5563">
    {variant === 'supplied' ? (
      <g>
        <text x="150" y={tip - 12} text-anchor="middle" font-size="11">bevels</text>
        <text x={edges[0] - 12} y={tip - 30} text-anchor="end">sharp edge</text>
        <line x1={edges[0] - 10} y1={tip - 25} x2={edges[0] - 2} y2={tip - 4} stroke="#4b5563" stroke-width="1" />
        <text x={edges[1] + 12} y={tip - 30}>sharp edge</text>
        <line x1={edges[1] + 10} y1={tip - 25} x2={edges[1] + 2} y2={tip - 4} stroke="#4b5563" stroke-width="1" />
      </g>
    ) : (
      <g>
        <text x={left - 12} y={bevelStart + 20} text-anchor="end">bevel</text>
        <text x={right + t + 12} y={bevelStart + 20}>bevel</text>
        <text x="0" y="0" text-anchor="middle" dominant-baseline="central" font-size="11" fill="#1a1a1a" transform={`translate(150 ${(bevelStart - 4) / 2}) rotate(-90)`}>purfling</text>
        <text x="150" y={bevelStart + 22} text-anchor="middle" font-size="11">sharp</text>
        <text x="150" y={bevelStart + 35} text-anchor="middle" font-size="11">edges</text>
        <line x1="140" y1={bevelStart + 42} x2={edges[0] + 2} y2={tip - 4} stroke="#4b5563" stroke-width="1" />
        <line x1="160" y1={bevelStart + 42} x2={edges[1] - 2} y2={tip - 4} stroke="#4b5563" stroke-width="1" />
      </g>
    )}
  </g>
</svg>
